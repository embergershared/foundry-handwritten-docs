{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "subscriptionCode": {
      "value": "${AZURE_SUBSCRIPTION_CODE}"
    },
    "deploymentProfile": {
      "value": "${DEPLOYMENT_PROFILE=core}"
    },
    "repository": {
      "value": "${AZURE_REPOSITORY}"
    },
    "featureOverridesBase64": {
      "value": "${AZURE_FEATURE_OVERRIDES_BASE64}"
    },
    "operatorPrincipalIdsCsv": {
      "value": "${AZURE_OPERATOR_PRINCIPAL_IDS}"
    },
    "createdOn": {
      "value": "${AZURE_CREATED_ON}"
    },
    "lastUpdatedOn": {
      "value": "${AZURE_LAST_UPDATED_ON}"
    },
    "enableKeyVaultPurgeProtection": {
      "value": "${AZURE_KEY_VAULT_PURGE_PROTECTION=true}"
    },
    "aiPublicNetworkAccess": {
      "value": "${AZURE_AI_PUBLIC_NETWORK_ACCESS=Disabled}"
    },
    "aiAllowedClientIpv4": {
      "value": "${AZURE_AI_ALLOWED_CLIENT_IPV4=}"
    },
    "visionDeploymentName": {
      "value": "${AZURE_VISION_DEPLOYMENT=handwriting-vision}"
    },
    "visionModel": {
      "value": "${AZURE_VISION_MODEL=gpt-4.1}"
    },
    "visionModelVersion": {
      "value": "${AZURE_VISION_MODEL_VERSION=2025-04-14}"
    },
    "visionCapacity": {
      "value": "${AZURE_VISION_CAPACITY=10}"
    }
  }
}
